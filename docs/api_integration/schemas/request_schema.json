{
  "ChatRequest": {
    "additionalProperties": false,
    "description": "One user message in a text chat session.",
    "properties": {
      "message": {
        "maxLength": 20000,
        "minLength": 1,
        "title": "Message",
        "type": "string"
      },
      "session_id": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9._:\\-]+$",
        "title": "Session Id",
        "type": "string"
      }
    },
    "required": [
      "session_id",
      "message"
    ],
    "title": "ChatRequest",
    "type": "object"
  },
  "KnowledgeSearchRequest": {
    "additionalProperties": false,
    "description": "Search the knowledge base.",
    "properties": {
      "query": {
        "maxLength": 300,
        "minLength": 1,
        "title": "Query",
        "type": "string"
      },
      "top_k": {
        "anyOf": [
          {
            "maximum": 20,
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Top K"
      }
    },
    "required": [
      "query"
    ],
    "title": "KnowledgeSearchRequest",
    "type": "object"
  },
  "TokenRequest": {
    "additionalProperties": false,
    "description": "Ask for a LiveKit join token. Both fields are generated when omitted.",
    "properties": {
      "identity": {
        "anyOf": [
          {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:\\-]+$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Identity"
      },
      "room": {
        "anyOf": [
          {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:\\-]+$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Room"
      }
    },
    "title": "TokenRequest",
    "type": "object"
  }
}

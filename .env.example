# OmniVox configuration. Copy to .env (make env) and fill in the secrets.
# Plain KEY=VALUE lines only: no quotes, no export, no inline comments.
# Works for pydantic-settings, Docker Compose env_file and systemd EnvironmentFile.
# A blank value means "unset" and the default from config/settings.py applies.

# --- App ---
# Service name, also used by the Makefile for systemd and nginx names.
APP_NAME=omnivox
# development or production
APP_ENV=development
# Address the API binds to.
HOST=0.0.0.0
# API port. 8100 avoids the common clash with other tools on 8000.
PORT=8100
# URL prefix of the feature routes (/health stays at the root).
API_PREFIX=/api/v1
# Set to /omnivox when nginx serves the API under a path prefix.
ROOT_PATH=
# Comma separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
# Comma separated API keys checked in the X-API-Key header. Empty disables auth.
API_KEYS=
# Reload on code changes (development only).
RELOAD=false
# Largest accepted request body in bytes (must exceed RAG_MAX_UPLOAD_BYTES).
MAX_BODY_BYTES=12582912
# Maximum concurrent agent runs handled by the text chat endpoints.
MAX_CONCURRENT_RUNS=8

# --- LLM (any OpenAI compatible endpoint, default Gemini) ---
# Key for the LLM endpoint (a Gemini key for the default base URL). Required.
OPENAI_API_KEY=
# OpenAI compatible base URL. Change it to use another provider or a vLLM server.
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Chat model name. It must support tool calling.
OPENAI_MODEL=gemini-3-flash-preview
# Sampling temperature. Gemini 3 works best at its default of 1.0.
OPENAI_TEMPERATURE=1.0
# Cap on reply tokens. Blank means no cap.
OPENAI_MAX_TOKENS=
# minimal, low, medium or high. Lower is faster for voice. Blank uses the model default.
OPENAI_REASONING_EFFORT=minimal
# Thinking for open-source and reasoning models (Qwen, Gemma, Nemotron on vLLM or OpenRouter).
# Sent as chat_template_kwargs.enable_thinking, plus OpenRouter's reasoning.enabled on openrouter.ai.
# false turns thinking off (faster replies), true turns it on, blank sends nothing and the model default applies.
OPENAI_ENABLE_THINKING=
# Retries inside the model clients for transient errors.
MAX_RETRIES=3
# Seconds before a model call times out.
REQUEST_TIMEOUT=60
# Longest user message accepted, in characters.
MAX_INPUT_CHARS=20000

# --- Embeddings (OpenAI compatible, default Cohere) ---
# OpenAI compatible embeddings endpoint.
EMBEDDING_BASE_URL=https://api.cohere.ai/compatibility/v1
# Embedding model name. Documents and queries must use the same family.
EMBEDDING_MODEL=embed-v5.0-fast
# Key for the embeddings endpoint (Cohere). Without it the knowledge base is unavailable.
EMBEDDING_API_KEY=
# Texts per embedding request (Cohere accepts at most 96).
EMBEDDING_BATCH_SIZE=96
# Embedding requests in flight at once.
EMBEDDING_CONCURRENCY=4

# --- Speech to text ---
# ElevenLabs API key (starts with sk_, not the key id). Needed when STT or TTS uses elevenlabs.
ELEVENLABS_API_KEY=
# elevenlabs (native streaming) or openai (any /v1/audio/transcriptions server, for example vLLM).
STT_PROVIDER=elevenlabs
# Speech to text model name.
STT_MODEL=scribe_v2_realtime
# Language code such as en or ar. Blank means automatic detection where supported.
STT_LANGUAGE=
# Only for STT_PROVIDER=openai, for example http://localhost:8001/v1
STT_BASE_URL=
# Key for that server. Blank is fine for servers without auth.
STT_API_KEY=

# --- Text to speech ---
# elevenlabs (native streaming) or openai (any /v1/audio/speech server, for example vLLM).
TTS_PROVIDER=elevenlabs
# Text to speech model name.
TTS_MODEL=eleven_v4_turbo
# ElevenLabs voice id (default: Sarah), or the voice name for an OpenAI compatible server.
# Free ElevenLabs plans cannot use library voices through the API; Sarah, Roger, George and Charlie work.
TTS_VOICE=EXAVITQu4vr4xnSDxMaL
# Only for TTS_PROVIDER=openai, for example http://localhost:8002/v1
TTS_BASE_URL=
# Key for that server. Blank is fine for servers without auth.
TTS_API_KEY=

# --- Voice pipeline ---
# Silero VAD: speech probability above this value counts as speech.
VAD_ACTIVATION_THRESHOLD=0.5
# Seconds of speech needed before VAD reports speech.
VAD_MIN_SPEECH_DURATION=0.05
# Seconds of silence before VAD reports the end of speech.
VAD_MIN_SILENCE_DURATION=0.55
# End of turn detection: audio (local LiveKit model), vad (silence only) or stt (STT endpointing).
TURN_DETECTOR=audio
# Shortest wait after speech ends before the reply starts, in seconds.
MIN_ENDPOINTING_DELAY=0.5
# Longest wait when the turn detector expects the user to keep talking, in seconds.
MAX_ENDPOINTING_DELAY=3.0
# Let the user talk over the agent.
ALLOW_INTERRUPTIONS=true
# Start the LLM before the turn is confirmed. Faster but may repeat tool calls.
PREEMPTIVE_GENERATION=false
# Spoken when a caller joins.
AGENT_GREETING=Hi, this is OmniVox. Ask me anything, or ask about your documents.
# Publish internal steps to the GUI Inspector over the LiveKit data channel.
INSPECTOR_ENABLED=true
# Longest text value inside an Inspector event.
INSPECTOR_MAX_FIELD_CHARS=1500

# --- LiveKit ---
# Pre-started job processes of the agent worker.
WORKER_IDLE_PROCESSES=1
# Port of the worker health endpoint (0 picks a free port).
WORKER_PORT=8181
# Server address used by the API and the agent worker.
LIVEKIT_URL=ws://localhost:7880
# Server address handed to the browser.
LIVEKIT_PUBLIC_URL=ws://localhost:7880
# Development defaults match the local Docker server started by docker compose.
LIVEKIT_API_KEY=devkey
# Secret of LIVEKIT_API_KEY. Required. Change both before exposing the server.
LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdevsecret
# Lifetime of browser join tokens, in seconds.
LIVEKIT_TOKEN_TTL_SECONDS=3600

# --- Knowledge base (Qdrant) ---
# Qdrant address. Use :memory: for a throwaway in-process store.
QDRANT_URL=http://localhost:6333/
# Qdrant API key. Blank for none.
QDRANT_API_KEY=
# Collection that holds the document chunks.
QDRANT_COLLECTION=omnivox_knowledge
# Characters per chunk.
RAG_CHUNK_SIZE=800
# Characters repeated between neighbouring chunks.
RAG_CHUNK_OVERLAP=100
# Passages returned per search.
RAG_TOP_K=4
# Drop passages scoring below this cosine similarity. 0 keeps everything.
# With embed-v5.0-fast, matching passages scored about 0.27 to 0.47 and unrelated text 0.13 to 0.19, so 0.2 filters noise.
RAG_SCORE_THRESHOLD=0.0
# Largest uploaded document, in bytes.
RAG_MAX_UPLOAD_BYTES=5000000

# --- Web search (ddgs) ---
# Results handed to the model per search.
WEB_SEARCH_MAX_RESULTS=5
# Seconds before a web search is abandoned.
WEB_SEARCH_TIMEOUT=10
# Region code such as us-en, uk-en or wt-wt (no region; some engines fail with it).
WEB_SEARCH_REGION=us-en

# --- Logging ---
# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO
# console or json
LOG_FORMAT=console
# Directory of the rotating log file (created if missing).
LOG_DIR=files/logs
# Size at which the log file rotates.
LOG_MAX_BYTES=10485760
# Rotated log files kept.
LOG_BACKUP_COUNT=5

# --- Tracing ---
# none or langsmith
TRACING_PROVIDER=none
# LangSmith key, required when TRACING_PROVIDER=langsmith.
LANGSMITH_API_KEY=
# LangSmith project that receives the runs.
LANGSMITH_PROJECT=omnivox

# --- Agent graph ---
# Maximum graph steps per turn. Stops runaway tool loops.
GRAPH_RECURSION_LIMIT=25
# memory or sqlite. Backs the text chat endpoints; voice history lives in LiveKit.
GRAPH_MEMORY_BACKEND=memory
# SQLite file path when GRAPH_MEMORY_BACKEND=sqlite.
GRAPH_MEMORY_URL=files/graph_memory.sqlite
# Messages kept in the model context per call.
GRAPH_MAX_HISTORY_MESSAGES=40

# --- Docker Compose only (not read by the app; uncomment to override) ---
# Host port of the bundled Qdrant container. Change it when 6333 is already taken.
# QDRANT_HOST_PORT=6333
# Point the containers at another Qdrant instead of the bundled one, for example
# http://host.docker.internal:6333/ for a Qdrant running on this machine.
# QDRANT_DOCKER_URL=http://qdrant:6333/
# Address LiveKit advertises for media. 127.0.0.1 suits a browser on the same machine;
# use the host LAN or public IP when browsers connect from other machines.
# LIVEKIT_NODE_IP=127.0.0.1
# Host port of the web GUI container.
# FRONTEND_PORT=8080
